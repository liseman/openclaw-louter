{
  "name": "@liseman/openclaw-louter",
  "version": "0.2.8",
  "description": "Keep simple replies local. Choose a model explicitly. Ask your configured models in parallel and retain their full answers.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "openclaw": {
    "extensions": [
      "./index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.9.4",
      "minGatewayVersion": "2026.9.4"
    },
    "build": {
      "openclawVersion": "2026.9.4",
      "pluginSdkVersion": "2026.9.4"
    }
  },
  "files": [
    "index.js",
    "src",
    "scripts",
    "test",
    "openclaw.plugin.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "config.example.json",
    "install.sh"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:smoke": "python3 scripts/smoke.py",
    "setup": "python3 scripts/setup_local.py",
    "setup:quick": "python3 scripts/setup.py",
    "prepack": "python3 scripts/clean_package.py"
  },
  "keywords": [
    "openclaw",
    "local-llm",
    "routing",
    "model-council",
    "privacy"
  ]
}
