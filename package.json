{
  "name": "openclaw-louter",
  "version": "0.2.2",
  "description": "Keep simple replies local. Choose a model explicitly. Ask your configured models in parallel and retain their full answers.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "openclaw": {
    "extensions": [
      "./index.js"
    ]
  },
  "files": [
    "index.js",
    "src",
    "scripts",
    "test",
    "openclaw.plugin.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "config.example.json",
    "install.sh"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:smoke": "python3 scripts/smoke.py",
    "setup": "python3 scripts/setup_local.py"
  },
  "keywords": [
    "openclaw",
    "local-llm",
    "routing",
    "model-council",
    "privacy"
  ]
}
